# Create a Supabase project, apply supabase/migrations/001_init.sql, then add these
# public browser-safe values to .env.local and to Vercel project environment variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server/admin-only: used by `npm run seed:users` and NEVER by the browser app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
